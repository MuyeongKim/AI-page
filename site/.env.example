# 운영 환경에서는 Vercel Project Settings의 Environment Variables에 설정합니다.
# 실제 비밀번호, 세션 비밀값, GitHub 토큰을 이 파일에 입력하거나 커밋하지 마세요.
ADMIN_PASSWORD_HASH=scrypt$16384$8$5$BASE64URL_SALT$BASE64URL_DIGEST
ADMIN_SESSION_SECRET=32바이트-이상의-무작위-비밀값
GITHUB_CONTENT_TOKEN=REPLACE_WITH_FINE_GRAINED_TOKEN

# 아래 값은 생략하면 이 기본값을 사용합니다.
GITHUB_CONTENT_OWNER=MuyeongKim
GITHUB_CONTENT_REPO=AI-page
GITHUB_CONTENT_BRANCH=content

# 실제 Vercel 운영 주소가 확정된 뒤 Production에만 설정합니다.
# SITE_URL=https://your-project.vercel.app
