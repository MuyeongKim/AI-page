  <script>
    interface PublicUpdate {
      id: string;
      kind: string;
      status: string;
      title: string;
      summary: string;
      body: string;
      version: string | null;
      audiences: string[];
      link_url: string | null;
      published_at: string | null;
      updated_at: string;
    }

    interface PublicFeed {
      schema_version: number;
      revision: number;
      items: PublicUpdate[];
    }

    const feedElement = document.querySelector<HTMLElement>("#public-update-feed");
    const feedStatus = document.querySelector<HTMLElement>("#update-feed-status");
    const kindLabels: Record<string, string> = {
      notice: "공지",
      release: "업데이트 안내",
      maintenance: "운영 안내",
    };

    const setFeedStatus = (message: string) => {
      if (feedStatus) feedStatus.textContent = message;
    };

    const formatDate = (value: string | null) => {
      if (!value) return "게시일 미정";
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return "게시일 미정";
      return new Intl.DateTimeFormat("ko-KR", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      }).format(date);
    };

    const safeHttpsUrl = (value: string | null) => {
      if (!value) return null;
      try {
        const url = new URL(value);
        return url.protocol === "https:" && !url.username && !url.password
          ? url.toString()
          : null;
      } catch {
        return null;
      }
    };

    const isPublicUpdate = (value: unknown): value is PublicUpdate => {
      if (!value || typeof value !== "object") return false;
      const item = value as Record<string, unknown>;
      const publishedTime =
        typeof item.published_at === "string" ? Date.parse(item.published_at) : Number.NaN;
      return (
        typeof item.id === "string" &&
        ["notice", "release", "maintenance"].includes(String(item.kind)) &&
        item.status === "published" &&
        typeof item.title === "string" &&
        typeof item.summary === "string" &&
        typeof item.body === "string" &&
        (item.version === null || typeof item.version === "string") &&
        Array.isArray(item.audiences) &&
        item.audiences.every((audience) => audience === "web" || audience === "desktop") &&
        item.audiences.includes("web") &&
        (item.link_url === null || typeof item.link_url === "string") &&
        Number.isFinite(publishedTime) &&
        publishedTime <= Date.now() &&
        typeof item.updated_at === "string"
      );
    };

    const createUpdateCard = (item: PublicUpdate) => {
      const article = document.createElement("article");
      article.className = "update-card";

      const meta = document.createElement("div");
      meta.className = "update-card-meta";
      const tags = document.createElement("div");
      tags.className = "update-card-tags";
      const kind = document.createElement("span");
      kind.textContent = kindLabels[item.kind] ?? "업데이트";
      tags.append(kind);
      if (item.version) {
        const version = document.createElement("span");
        version.textContent = `V${item.version.replace(/^V/i, "")}`;
        tags.append(version);
      }
      const time = document.createElement("time");
      const dateValue = item.published_at ?? item.updated_at;
      time.dateTime = dateValue;
      time.textContent = formatDate(dateValue);
      meta.append(tags, time);

      const title = document.createElement("h3");
      title.textContent = item.title;
      const summary = document.createElement("p");
      summary.className = "update-summary";
      summary.textContent = item.summary;
      const body = document.createElement("p");
      body.className = "update-body";
      body.textContent = item.body;
      article.append(meta, title, summary, body);

      const linkUrl = safeHttpsUrl(item.link_url);
      if (linkUrl) {
        const link = document.createElement("a");
        link.href = linkUrl;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.textContent = "관련 내용 보기 →";
        article.append(link);
      }
      return article;
    };

    const renderUpdates = (items: PublicUpdate[]) => {
      if (!feedElement) return;
      if (items.length === 0) {
        const empty = document.createElement("p");
        empty.className = "empty-update-state";
        empty.textContent = "현재 게시된 업데이트 소식이 없습니다.";
        feedElement.replaceChildren(empty);
        return;
      }
      const fragment = document.createDocumentFragment();
      items.forEach((item) => fragment.append(createUpdateCard(item)));
      feedElement.replaceChildren(fragment);
    };

    const loadLatestUpdates = async () => {
      if (!feedElement) return;
      const fallbackRevision = Number.parseInt(feedElement.dataset.revision ?? "0", 10) || 0;
      try {
        const response = await fetch("/api/updates", {
          headers: { Accept: "application/json" },
          cache: "no-store",
        });
        if (!response.ok) throw new Error("update fetch failed");
        const payload = (await response.json()) as Partial<PublicFeed>;
        if (
          payload.schema_version !== 1 ||
          !Number.isSafeInteger(payload.revision) ||
          typeof payload.revision !== "number" ||
          !Array.isArray(payload.items)
        ) {
          throw new Error("invalid update feed");
        }
        if (payload.revision >= fallbackRevision) {
          const items = payload.items
            .filter(isPublicUpdate)
            .sort(
              (left, right) =>
                Date.parse(right.published_at ?? right.updated_at) -
                Date.parse(left.published_at ?? left.updated_at),
            );
          renderUpdates(items);
          feedElement.dataset.revision = String(payload.revision);
          setFeedStatus("온라인 공지를 최신 상태로 불러왔습니다.");
        } else {
          setFeedStatus("현재 최신 공지를 표시하고 있습니다.");
        }
      } catch {
        setFeedStatus("온라인 확인이 어려워 페이지에 포함된 마지막 공지를 표시합니다.");
      } finally {
        feedElement.setAttribute("aria-busy", "false");
      }
    };

    void loadLatestUpdates();
  </script>
</BaseLayout>
