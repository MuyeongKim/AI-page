---
import releaseFeed from "../../../latest_version.json";
import updateFeed from "../../../site_updates.json";
import currentAppImage from "../../../docs/images/manual-main-V26.0908.png";
import manualUrl from "../../../output/pdf/Stay-Up-AI-사용설명서-V26.0908.pdf?url";
import BaseLayout from "../layouts/BaseLayout.astro";

interface DownloadInfo {
  status: "preparing" | "ready" | "unavailable";
  provider: "google_drive";
  platform: "Windows";
  url: string | null;
  filename?: string | null;
  size_bytes: number | null;
  sha256: string | null;
}

interface SiteUpdate {
  id: string;
  kind: string;
  status: string;
  title: string;
  summary: string;
  body: string;
  version: string | null;
  audiences: string[];
  link_url: string | null;
  published_at: string | null;
  created_at: string;
  updated_at: string;
}

const githubUrl = "https://github.com/MuyeongKim/AI-page";
const versionLabel = `V${releaseFeed.version}`;
const guideVersion = "26.0908";
if (guideVersion !== releaseFeed.version) {
  throw new Error("현재 릴리스에 맞는 Windows 화면과 PDF 사용설명서를 연결해 주세요.");
}
const manualFilename = `Stay-Up-AI-사용설명서-V${guideVersion}.pdf`;
const download = releaseFeed.download as DownloadInfo;
const downloadReady =
  download.status === "ready" &&
  typeof download.url === "string" &&
  typeof download.size_bytes === "number" &&
  typeof download.sha256 === "string";
const downloadUrl = downloadReady ? download.url : null;
const formatBytes = (bytes: number) => {
  if (bytes >= 1024 ** 3) return `${(bytes / 1024 ** 3).toFixed(2)} GB`;
  if (bytes >= 1024 ** 2) return `${(bytes / 1024 ** 2).toFixed(1)} MB`;
  if (bytes >= 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${bytes} B`;
};
const downloadSize =
  downloadReady && download.size_bytes !== null ? formatBytes(download.size_bytes) : null;
const currentYear = new Date().getFullYear();
const fallbackUpdates = (updateFeed.items as SiteUpdate[])
  .filter(
    (item) =>
      item.status === "published" &&
      item.audiences.includes("web") &&
      typeof item.published_at === "string" &&
      Date.parse(item.published_at) <= Date.now(),
  )
  .sort(
    (left, right) =>
      Date.parse(right.published_at ?? right.updated_at) -
      Date.parse(left.published_at ?? left.updated_at),
  );
const updateKindLabels: Record<string, string> = {
  notice: "공지",
  release: "업데이트 안내",
  maintenance: "운영 안내",
};
const formatUpdateDate = (value: string | null) => {
  if (!value) return "게시일 미정";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "게시일 미정";
  return new Intl.DateTimeFormat("ko-KR", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).format(date);
};
const safeUpdateLink = (value: string | null) => {
  if (!value) return null;
  try {
    const url = new URL(value);
    return url.protocol === "https:" && !url.username && !url.password ? url.toString() : null;
  } catch {
    return null;
  }
};

const features = [
  {
    number: "01",
    title: "사진 분석",
    description:
      "여러 사진이나 폴더를 분석합니다. 탐지된 사진은 원본과 표시본을 함께 저장합니다.",
    meta: "JPG · PNG · BMP · TIF",
  },
  {
    number: "02",
    title: "영상 분석",
    description:
      "영상 파일 한 개를 분석하고 검증된 결과 영상을 저장합니다. 결과는 무음 CFR MP4로 생성됩니다.",
    meta: "MP4 · MOV · AVI · MKV · WEBM",
  },
  {
    number: "03",
    title: "캡처보드 미리보기",
    description:
      "외부 영상을 확인하고 사람·차량의 최대 동시 탐지 수를 보여줍니다. 현재 영상 저장은 지원하지 않습니다.",
    meta: "실시간 미리보기 · 탐지 수 집계",
  },
  {
    number: "04",
    title: "선택적 GPS 지도",
    description:
      "GPS 정보가 있는 탐지 사진은 사용자가 동의한 경우에만 지도에 표시합니다.",
    meta: "EXIF 좌표 · 사용자 확인 후 실행",
  },
];

const workflow = [
  ["입력 선택", "사진, 영상 파일 또는 캡처보드를 선택합니다."],
  ["탐지 설정", "모델, 사람·차량, 신뢰도, 해상도와 실행 장치를 확인합니다."],
  [
    "탐지 실행",
    "진행 상태와 미리보기를 확인합니다. 완료·부분 완료·실패·취소·연결 끊김을 구분합니다.",
  ],
  ["결과 확인", "작업 결과 탭에서 원본과 비교하고 저장 폴더를 엽니다. 실행마다 새 폴더에 결과가 모입니다."],
];

const faqs = [
  [
    "어떤 대상을 탐지하나요?",
    "사람과 차량(승용차·버스·트럭) 후보를 탐지합니다. 얼굴 식별과 화재·연기 탐지는 지원하지 않습니다.",
  ],
  [
    "어떤 파일을 사용할 수 있나요?",
    "사진은 JPG·JPEG·PNG·BMP·TIF·TIFF, 영상은 MP4·MOV·AVI·MKV·WMV·WEBM을 지원합니다. 영상 파일은 한 번에 하나씩 처리합니다.",
  ],
  [
    "탐지 결과는 어디에서 찾나요?",
    "작업 결과 탭의 ‘저장 폴더 열기’를 누르세요. 사진·영상 분석은 detected_files 아래 시작 시각별 새 폴더에 저장되며, 사진 원본·탐지본과 후속 GPS 지도도 같은 실행 폴더에 모입니다. 다시 실행해도 이전 결과는 남습니다.",
  ],
  [
    "파일이 외부로 전송되나요?",
    "탐지는 로컬 PC에서 수행됩니다. 다만 모델 다운로드, 버전 확인과 GPS 지도 타일 표시에는 인터넷이 사용될 수 있습니다.",
  ],
  [
    "macOS에서도 사용할 수 있나요?",
    "Python 실행 환경에서는 macOS를 지원하며, 사용 가능한 경우 Apple MPS를 자동으로 선택합니다. 배포 패키지는 검증 후 별도로 안내합니다.",
  ],
];
---

<BaseLayout
  title="AI 객체 탐지 프로그램 | Stay Up"
  description="사진·영상과 캡처보드 입력에서 사람과 차량 후보를 확인하는 로컬 AI 객체 탐지 도구입니다."
>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="#top" aria-label="AI 객체 탐지 프로그램 홈">
        <span class="brand-mark" aria-hidden="true">SU</span>
        <span>AI 객체 탐지</span>
      </a>
      <nav aria-label="주요 메뉴">
        <a href="#features">기능</a>
        <a href="#field-scenes">현장 사진</a>
        <a href="#workflow">운용 흐름</a>
        <a href="#updates">업데이트</a>
        <a class="nav-cta" href="#user-manual">사용설명서</a>
      </nav>
      <details class="mobile-menu">
        <summary aria-label="주 메뉴 열기">메뉴</summary>
        <div>
          <a href="#features">기능</a>
          <a href="#field-scenes">현장 사진</a>
          <a href="#workflow">운용 흐름</a>
          <a href="#updates">업데이트</a>
          <a href="#download">다운로드</a>
          <a href="#user-manual">사용설명서</a>
          <a href={githubUrl}>GitHub</a>
        </div>
      </details>
    </div>
  </header>

  <main id="main-content">
    <section class="hero" id="top">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> 현장 영상 검토 보조 도구</p>
          <h1>사진과 영상에서<br /><strong>사람·차량 후보</strong>를 확인하세요</h1>
          <p class="hero-description">
            사진·영상 파일과 캡처보드 입력에서 사람·차량 후보 영역을 표시하는 로컬 AI
            도구입니다. 결과는 반드시 원본과 함께 확인하세요.
          </p>
          <div class="hero-actions" role="group" aria-label="주요 작업">
            {
              downloadReady ? (
                <a class="button button-download" href={downloadUrl}>Windows 배포본 받기</a>
              ) : (
                <span class="button button-muted">
                  다운로드 준비 중
                </span>
              )
            }
            <a class="button button-primary" href="#user-manual">사용설명서 보기</a>
          </div>
          <div class="release-line">
            <span>{versionLabel}</span>
            <span>{releaseFeed.release_date}</span>
            <span>AGPL-3.0</span>
          </div>
          <a class="text-link" href="#current-app">현재 프로그램 화면과 사용 순서 보기 →</a>
        </div>

        <div class="product-preview">
          <figure class="hero-field-figure">
            <div class="hero-field-frame">
              <img
                src="/images/field/drone-demonstration.avif"
                alt="강의실 스크린에 실내 사람 객체 탐지 화면이 투사되고 앞에 드론이 놓인 시연 모습"
                width="960"
                height="720"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
              <span class="field-context-label">기존 현장 시연 사진</span>
            </div>
            <div class="hero-result-inset">
              <img
                src="/images/field/aerial-detection-results.avif"
                alt="고도 50미터 항공 원본과 AI 실행 결과, 사람 후보 확대 화면을 나란히 비교한 자료"
                width="729"
                height="671"
                loading="eager"
                decoding="async"
              />
              <span>항공 영상 분석 예시</span>
            </div>
            <figcaption>
              강의실 스크린에 드론 촬영 화면의 사람 후보 탐지 결과를 투사한 시연 장면입니다.
            </figcaption>
          </figure>
          <p class="preview-caption">
            기존 홍보 페이지에 사용된 당시 화면 예시이며, 실제 탐지 성능이나 결과를 보증하지
            않습니다.
          </p>
        </div>
      </div>
    </section>

    <section class="trust-strip" aria-label="제품 핵심 정보">
      <div class="container trust-grid">
        <div><strong>로컬 분석</strong><span>사진·영상 원본 외부 전송 없음</span></div>
        <div><strong>3가지 입력</strong><span>사진 · 영상 · 캡처보드</span></div>
        <div><strong>사람·차량</strong><span>대상별 또는 함께 탐지</span></div>
        <div><strong>선택적 지도</strong><span>동의한 경우에만 GPS 표시</span></div>
      </div>
    </section>

    <section class="section features-section" id="features" aria-labelledby="features-title">
      <div class="container">
        <p class="section-kicker">CORE FEATURES</p>
        <div class="section-heading-row">
          <h2 id="features-title">입력부터 결과 확인까지<br />한 흐름으로</h2>
          <p>
            현장에서 확보한 사진과 영상을 로컬 PC에서 분석하고, 사람이 다시 확인할 수 있는
            결과를 남깁니다.
          </p>
        </div>
        <div class="feature-grid">
          {
            features.map((feature) => (
              <article class="feature-card">
                <span class="card-number" aria-hidden="true">{feature.number}</span>
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
                <span class="card-meta">{feature.meta}</span>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section current-app-section" id="current-app" aria-labelledby="current-app-title">
      <div class="container current-app-layout">
        <figure class="field-card">
          <a class="current-app-screen" href={currentAppImage.src} target="_blank" rel="noopener noreferrer" aria-label={`${versionLabel} Windows 프로그램 화면 크게 보기, 새 탭`}>
            <img
              data-current-app-image
              src={currentAppImage.src}
              alt={`${versionLabel} Windows 초기 화면: 입력 소스, 탐지 모델, 파일 선택, 실행 옵션과 작업 결과 탭`}
              width={currentAppImage.width}
              height={currentAppImage.height}
              loading="lazy"
              decoding="async"
            />
          </a>
          <figcaption>
            <span>{versionLabel} · Windows 실행 화면</span>
            <strong><a href={currentAppImage.src} target="_blank" rel="noopener noreferrer" aria-label={`${versionLabel} Windows 프로그램 화면 크게 보기, 새 탭`}>프로그램 화면 크게 보기 ↗</a></strong>
            <small>현재 소스로 실행한 탐지 전 설정 화면입니다. 실행 장치는 PC에서 사용할 수 있는 GPU 또는 CPU 등으로 자동 선택됩니다.</small>
          </figcaption>
        </figure>
        <div class="current-app-copy">
          <p class="section-kicker">PROGRAM SCREEN</p>
          <h2 id="current-app-title">화면에서 바로 이어지는<br />실행과 결과 확인</h2>
          <p>처음 사용할 때는 짧은 영상이나 몇 장의 사진으로 설정과 저장 결과를 먼저 확인하세요.</p>
          <ol class="current-app-steps">
            <li>
              <strong>입력과 탐지 설정 확인</strong>
              <p>사진·영상 또는 캡처보드를 선택하고 사람·차량, 신뢰도와 실행 장치를 확인합니다.</p>
            </li>
            <li>
              <strong>탐지 실행과 진행 상태 확인</strong>
              <p>미리보기와 진행 상태를 확인합니다. 중단이 필요하면 취소 버튼을 사용하고 처리 종료를 기다립니다.</p>
            </li>
            <li>
              <strong>저장된 결과를 원본과 비교</strong>
              <p>작업 결과 탭에서 ‘원본과 비교’ 또는 ‘저장 폴더 열기’를 누릅니다. 사진·영상은 시작 시각별 새 폴더에 저장되어 이전 실행 결과와 구분됩니다. 캡처보드는 영상을 저장하지 않습니다.</p>
            </li>
          </ol>
          <section class="manual-card" id="user-manual" aria-labelledby="user-manual-title">
            <span class="manual-meta">{versionLabel} · PDF 사용설명서</span>
            <h3 id="user-manual-title">사진 한 장부터 따라 해 보세요</h3>
            <p>프로그램 실행과 인증부터 사진·영상 분석, 결과 폴더 확인, GPS 지도와 문제 해결까지 안내합니다.</p>
            <div class="manual-actions">
              <a class="button button-primary" data-user-manual href={manualUrl} target="_blank" rel="noopener noreferrer" aria-label={`${versionLabel} PDF 사용설명서 보기, 새 탭`}>사용설명서 보기 ↗</a>
              <a class="button button-outline" data-user-manual href={manualUrl} download={manualFilename}>PDF 다운로드</a>
            </div>
            <small>Windows 실행 파일 사용 기준입니다. 설명서의 버전과 받은 프로그램의 버전을 확인하세요.</small>
          </section>
        </div>
      </div>
    </section>

    <section
      class="section field-scenes-section"
      id="field-scenes"
      aria-labelledby="field-scenes-title"
    >
      <div class="container">
        <div class="section-heading-row field-scenes-heading">
          <div>
            <p class="section-kicker">FIELD SCENES</p>
            <h2 id="field-scenes-title">기존 현장 기록을<br />그대로 이어갑니다</h2>
          </div>
          <p>
            이전 홍보 페이지에서 사용하던 프로그램 화면과 현장 시연 사진을 보존했습니다. 현재
            버전의 기능 범위와 화면은 달라질 수 있으므로 최신 안내와 함께 확인해 주세요.
          </p>
        </div>

        <div class="field-gallery">
          <figure class="field-card field-card-interface">
            <div class="field-card-media">
              <img
                src="/images/field/app-interface.avif"
                alt="V26.04.09 객체 탐지 프로그램의 설정 항목과 실행 상태가 표시된 이전 버전 화면"
                width="1079"
                height="1333"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>
              <span>이전 버전 실제 실행 화면</span>
              <strong>프로그램 설정과 분석 흐름</strong>
              <small>V26.04.09 당시 화면으로, 현재 버전의 UI·라이선스 표기와 다릅니다.</small>
            </figcaption>
          </figure>

          <figure class="field-card field-card-indoor">
            <div class="field-card-media">
              <img
                src="/images/field/indoor-detection-demo.avif"
                alt="강의실 스크린의 실내 드론 영상에서 여러 사람 후보에 탐지 상자가 표시된 모습"
                width="960"
                height="720"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>
              <span>실내 영상 시연</span>
              <strong>영상 속 사람 후보 확인</strong>
              <small>촬영 환경에 따라 오탐과 미탐이 발생할 수 있습니다.</small>
            </figcaption>
          </figure>

          <figure class="field-card field-card-aerial">
            <div class="field-card-media">
              <img
                src="/images/field/aerial-detection-results.avif"
                alt="고도 50미터 항공 원본과 AI 실행 결과, 여러 사람 후보 확대 화면을 나란히 비교한 자료"
                width="729"
                height="671"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>
              <span>항공 영상 분석</span>
              <strong>넓은 구역의 후보 위치 확인</strong>
              <small>표시된 결과는 참고용이며 구조·수색 판단을 대신하지 않습니다.</small>
            </figcaption>
          </figure>
        </div>

        <p class="field-gallery-notice">
          모든 사진은 당시 프로그램과 시연 환경을 보여주는 예시입니다. 특정 환경에서의 정확도나
          실제 운용 성능을 보증하지 않습니다.
        </p>
      </div>
    </section>

