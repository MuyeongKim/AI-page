---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonicalUrl = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : null;
const socialImageUrl = Astro.site && !noindex ? new URL("/og.png", Astro.site) : null;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={Astro.site && !noindex ? "index, follow" : "noindex, nofollow, noarchive"}
    />
    <meta name="theme-color" content="#07111f" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {
      canonicalUrl && socialImageUrl && (
        <>
          <meta property="og:url" content={canonicalUrl} />
          <meta property="og:image" content={socialImageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content="AI 객체 탐지 프로그램 소셜 미리보기" />
          <meta name="twitter:image" content={socialImageUrl} />
          <link rel="canonical" href={canonicalUrl} />
        </>
      )
    }
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 바로가기</a>
    <slot />
  </body>
</html>
