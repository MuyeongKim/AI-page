{
  "name": "stayup-ai-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "release:check": "node scripts/check-release.mjs",
    "test:api": "node --test tests/*.test.mjs",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "verify": "html-validate dist/index.html && node scripts/verify-build.mjs",
    "test": "npm run release:check && npm run test:api && npm run build && npm run verify"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.2.2",
    "html-validate": "^11.7.0",
    "typescript": "^6.0.3"
  }
}
